# DeskTime API Keys
DESKTIME_API_KEY_TN=your_api_key_here
DESKTIME_API_KEY_BAY=your_api_key_here

# Database Configuration (if managed via .env)
# DB_HOST=localhost
# DB_NAME=wfm_platform
# DB_USER=root
# DB_PASS=

# Extra database shown in Analytics > Databases (the `telecom_mysql` container). Nothing
# else in the platform reads from it -- it only populates the viewer's source picker.
# The source stays hidden while HOST or USER is empty; that is the switch to turn it off.
# Leaving NAME empty does NOT hide it: it makes the whole server browsable, one picker
# entry per schema, at the cost of a connection on every load of the viewer to run
# SHOW DATABASES. Pin NAME to one database to avoid that round trip.
# TELECOM_DB_HOST=
# TELECOM_DB_PORT=3306
# TELECOM_DB_NAME=
# TELECOM_DB_USER=
# TELECOM_DB_PASS=

# Bonus approval notification (Configuration > HR > Bonus Approval Email).
# Without SMTP_HOST an approval still completes and locks the period — it just reports that
# the Finance notification could not be sent. The php:8.2-apache image has no local MTA.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=tls          # tls (STARTTLS, port 587), ssl (implicit, port 465), or none
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hr@company.com
# SMTP_FROM_NAME=HR Bonus
