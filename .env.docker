# Template for the .env that docker-compose mounts into the container.
#
# The compose file no longer declares DB_* or the API keys as environment variables:
# db_wfm_config.php lets getenv() override this file, so anything set there would shadow
# these values until the container is recreated. Everything below is read straight from
# the mounted file, which means repointing the database or rotating a key takes effect on
# the next request.

# Database Configuration — point this at the MariaDB server that holds the real data,
# not at a container. There is no `db` service in docker-compose.yml any more.
DB_HOST=your_db_host
DB_NAME=wfm_platform
DB_USER=your_db_user
DB_PASS=your_db_password

# DeskTime API Keys
DESKTIME_API_KEY_TN=your_api_key_here
DESKTIME_API_KEY_BAY=your_api_key_here
